{
  "name": "compression-project-docs",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@10.30.3",
  "docs": {
    "title": "Compression",
    "description": "Assessment brief, submission guidance, and project proposal.",
    "out": "dist/docs"
  },
  "scripts": {
    "docs": "docs dev --port 3010",
    "docs:doxygen": "doxygen config/Doxyfile",
    "build": "make && docs build --out dist/docs",
    "quality": "cd config && node ../scripts/terra-quality.mjs",
    "quality:all": "pnpm run quality",
    "format:c": "make format-c",
    "format:c:check": "make format-c-check",
    "format": "prettier --write README.md 'docs/**/*.{md,mdx}' '!docs/assessment/assignment/brief.md'",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@terra-symposium/docs": "^0.4.3",
    "@terra-symposium/standards-quality": "2.1.0",
    "astro": "^7.4.4",
    "husky": "^9.1.7",
    "prettier": "^3.9.10"
  }
}
