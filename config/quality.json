{
  "$schema": "../node_modules/@terra-symposium/standards-quality/quality.schema.json",
  "root": ".",
  "sourceRoots": ["."],
  "extensions": [
    ".astro",
    ".c",
    ".cjs",
    ".cpp",
    ".cts",
    ".css",
    ".h",
    ".html",
    ".java",
    ".js",
    ".jsx",
    ".json",
    ".jsonc",
    ".md",
    ".mdx",
    ".mjs",
    ".mts",
    ".py",
    ".pyi",
    ".rs",
    ".sh",
    ".sql",
    ".toml",
    ".ts",
    ".tsx",
    ".yaml",
    ".yml"
  ],
  "languageProfiles": ["c", "java", "python"],
  "qualityCommands": [
    {
      "name": "c-doc-params",
      "command": "make",
      "args": ["check-doc-params"]
    },
    {
      "name": "format-c",
      "command": "pnpm",
      "args": ["run", "format:c:check"]
    }
  ],
  "tools": {
    "prettier": "node_modules/.bin/prettier",
    "eslint": "node_modules/.bin/eslint",
    "knip": "node_modules/.bin/knip"
  },
  "enabledChecks": {
    "error-boundaries": true,
    "document": true,
    "format": true,
    "import": true,
    "name": true,
    "forward": true,
    "accessibility": true,
    "display-name": true,
    "performance-patterns": true,
    "documented-commands": true,
    "lint": true,
    "knip": true,
    "dead-code": true,
    "type": true,
    "recommend": true,
    "command": true,
    "diff": true,
    "alias": true,
    "security": true,
    "repeated-classes": true,
    "tailwind-canonical": true,
    "regex-dedup": true,
    "ui-patterns": true,
    "ui-recommendations": true,
    "github": true
  },
  "documentation": {
    "required": {
      "types": true,
      "functions": true,
      "exportedFunctions": true
    }
  },
  "autofix": {
    "document": false
  },
  "security": {
    "runtimeRoots": ["scripts/run-native-tool.test.mjs"]
  }
}
