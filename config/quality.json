{
	"sourceRoots": ["."],
	"documentation": {
		"required": { "importSection": true, "fileHeader": true, "multilineTsdoc": true }
	},
	"extensions": [".c", ".h", ".cjs", ".css", ".html", ".js", ".json", ".md", ".mdx", ".mjs", ".toml", ".yaml", ".yml"],
	"languageProfiles": ["c"],
	"enabledChecks": {
		"error-boundaries": true,
		"document": true,
		"format": true,
		"import": true,
		"name": true,
		"forward": true,
		"accessibility": true,
		"display-name": true,
		"performance-patterns": true,
		"documented-commands": true,
		"lint": true,
		"knip": true,
		"dead-code": true,
		"type": true,
		"recommend": true,
		"command": true,
		"diff": true,
		"alias": true,
		"security": true,
		"repeated-classes": true,
		"tailwind-canonical": true,
		"regex-dedup": true,
		"ui-patterns": true,
		"ui-recommendations": true,
		"github": true
	},
	"tools": {
		"eslint": "node_modules/.bin/eslint",
		"knip": "node_modules/.bin/knip",
		"prettier": "node_modules/.bin/prettier"
	},
	"qualityCommands": [
		{
			"name": "c-doc-params",
			"command": "make",
			"args": ["check-doc-params"]
		}
	]
}
